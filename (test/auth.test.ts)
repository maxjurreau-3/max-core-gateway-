import { describe, it, expect, beforeEach } from "vitest";
import { verifySovereignSession, SessionContext } from "../src/middleware/auth";

const TEST_SECRET = "max_sec_test_entropy_key_998877665544332211";

// Helper to mint valid tokens for test assertions
async function mintTestToken(payload: object, secret: string): Promise<string> {
  const header = { alg: "HS256", typ: "JWT" };
  
  const b64Url = (str: string) => 
    Buffer.from(str).toString("base64").replace(/=/g, "").replace(/\+/g, "-").replace(/\//g, "_");
  
  const encodedHeader = b64Url(JSON.stringify(header));
  const encodedPayload = b64Url(JSON.stringify(payload));
  const signingInput = `${encodedHeader}.${encodedPayload}`;

  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"]
  );

  const signature = await crypto.subtle.sign(
    "HMAC",
    key,
    new TextEncoder().encode(signingInput)
  );

  const encodedSig = Buffer.from(signature)
    .toString("base64")
    .replace(/=/g, "")
    .replace(/\+/g, "-")
    .replace(/\//g, "_");

  return `sovereign_session=${encodedHeader}.${encodedPayload}.${encodedSig}`;
}

describe("verifySovereignSession", () => {
  it("successfully validates a well-formed and active session token", async () => {
    const futureExp = Math.floor(Date.now() / 1000) + 3600;
    const cookie = await mintTestToken(
      { sub: "user_alpha_1", role: "architect", exp: futureExp },
      TEST_SECRET
    );

    const result = await verifySovereignSession(cookie, TEST_SECRET);
    
    expect(result.valid).toBe(true);
    expect(result.userId).toBe("user_alpha_1");
    expect(result.role).toBe("architect");
  });

  it("rejects tokens with expired timestamps", async () => {
    const pastExp = Math.floor(Date.now() / 1000) - 300; // 5 mins ago
    const cookie = await mintTestToken(
      { sub: "user_beta_2", role: "user", exp: pastExp },
      TEST_SECRET
    );

    const result = await verifySovereignSession(cookie, TEST_SECRET);
    expect(result.valid).toBe(false);
    expect(result.userId).toBe("");
  });

  it("rejects tokens signed with an incorrect secret", async () => {
    const futureExp = Math.floor(Date.now() / 1000) + 3600;
    const cookie = await mintTestToken(
      { sub: "user_gamma_3", role: "admin", exp: futureExp },
      "wrong_secret_key_1234567890"
    );

    const result = await verifySovereignSession(cookie, TEST_SECRET);
    expect(result.valid).toBe(false);
  });

  it("safely handles malformed token structures without throwing errors", async () => {
    const malformedCookie = "sovereign_session=not.enough.parts";
    const result = await verifySovereignSession(malformedCookie, TEST_SECRET);
    
    expect(result.valid).toBe(false);
  });

  it("fails closed when HMAC_SECRET binding is missing", async () => {
    const cookie = await mintTestToken({ sub: "test", exp: 9999999999 }, TEST_SECRET);
    
    await expect(verifySovereignSession(cookie, "")).rejects.toThrow(
      "HMAC_SECRET environment binding is missing or unset."
    );
  });
});
